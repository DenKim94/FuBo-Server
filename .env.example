DB_HOST=localhost
DB_PORT=5432
DB_NAME=fubo
DB_USER=fubo_app
DB_PASSWORD=

FUBO_LOCAL_SEED=

# Zentrale PIN beim allerersten Start. Fehlt der Wert, erzeugt der PinBootstrap eine
# Zufalls-PIN und schreibt sie einmalig ins Log. Nach dem ersten Start entfernbar.
FUBO_INITIAL_PIN=

# Admin-Konto beim allerersten Start (AdminBootstrap, Abschnitt 9).
# ADMIN_NAME bestimmt das Adminprofil: Existiert ein Profil dieses Namens in profil.spieler,
# erhaelt es die Rolle ADMIN; existiert keines, wird es angelegt.
# Das Adminprofil ist ein technisches Konto - es steht nicht in der Namensliste, spielt nicht
# mit und bekommt Skillwerte 0. ADMIN_NAME darf deshalb ein Kontoname sein und muss kein
# Spielername sein. Der Admin meldet sich mit ADMIN_PASSWORD an, nicht ueber die Namenswahl.
# Fehlt eine der drei Angaben und existiert noch kein Admin-Konto, bricht der Start mit einer
# benennenden Meldung ab - ein willkuerlich gewaehlter Admin waere ein stilles
# Sicherheitsproblem. Achtung: Ein Tippfehler in ADMIN_NAME legt ein ueberfluessiges Profil
# an, statt abzubrechen; die Startmeldung sagt ausdruecklich, ob ein Profil uebernommen oder
# neu angelegt wurde.
# Nach dem ersten Start sind die drei Werte entbehrlich: Der Bootstrap ist idempotent und
# setzt ein geaendertes Passwort nicht zurueck. ADMIN_PASSWORD danach entfernen.
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Vollstaendige Origin inkl. Schema, ohne Pfad und ohne abschliessenden Schraegstrich.
# Mehrere Werte kommagetrennt. Nur klein schreiben - der Browser sendet den
# Hostnamen im Origin-Header immer in Kleinbuchstaben.
FUBO_CORS_ALLOWED_ORIGINS=http://localhost:5173
