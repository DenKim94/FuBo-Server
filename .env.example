# Von der Anwendung gelesen (application.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fubo
DB_USER=fubo_app
DB_PASSWORD=

# Pfad zu den Produktionsdaten
FUBO_LOCAL_SEED=

# Datenbank - vom Postgres-Image beim ersten Start ausgewertet
POSTGRES_DB=fubo
POSTGRES_USER=fubo_app
POSTGRES_PASSWORD=

# Zentrale PIN beim allerersten Start. Fehlt der Wert, erzeugt der PinBootstrap eine
# vierstellige Zufalls-PIN und schreibt sie einmalig ins Log. Nach dem ersten Start entfernbar.
# Empfehlung: ebenfalls vierstellig und rein numerisch waehlen - der Adminendpunkt
# /admin/pin/aendern laesst nur dieses Format zu, und das Eingabefeld im Frontend ist darauf
# ausgelegt. Der Anmeldeendpunkt selbst akzeptiert zwar jeden Wert, ein abweichendes Format
# waere aber nur ueber Umwege eingebbar.
FUBO_INITIAL_PIN=

# Admin-Konto beim allerersten Start (AdminBootstrap, Abschnitt 9).
# ADMIN_NAME bestimmt das Adminprofil: Existiert ein Profil dieses Namens in profil.spieler,
# erhaelt es die Rolle ADMIN; existiert keines, wird es angelegt.
# Das Adminprofil ist ein technisches Konto - es steht nicht in der Namensliste, spielt nicht
# mit und bekommt Skillwerte 0. ADMIN_NAME darf deshalb ein Kontoname sein und muss kein
# Spielername sein. Der Admin meldet sich mit ADMIN_NAME und ADMIN_PASSWORD an, nicht ueber
# die Namenswahl.
# ADMIN_NAME ist seit dem 29.08.2026 zugleich der Anmeldename: /auth/admin/anmelden verlangt
# Name und Passwort. Der Name ist ueber keinen Endpunkt abrufbar (das Adminprofil ist aus der
# Namensliste ausgeschlossen) und deshalb als zweite Angabe brauchbar - behandle ihn wie ein
# Geheimnis, auch wenn er nur ein Name ist.
# ACHTUNG, die Schreibweise zaehlt: Der Anmeldename wird zeichengenau geprueft, Gross- und
# Kleinschreibung eingeschlossen. Existiert bereits ein Profil, das sich nur in der
# Schreibweise unterscheidet, bricht der Start mit einer benennenden Meldung ab - lieber ein
# Neustart mit korrigierter .env als ein ausgesperrter Admin: Der Passwort-Reset holt das
# Passwort zurueck, nie den Namen. Randleerzeichen entfernt der Server selbst.
# Wird das Adminprofil spaeter im Adminbereich (S3) umbenannt, aendert sich damit auch der
# Anmeldename; ADMIN_NAME ist ab dann veraltet und wird nicht mehr gelesen.
# Fehlt eine der drei Angaben und existiert noch kein Admin-Konto, bricht der Start mit einer
# benennenden Meldung ab - ein willkuerlich gewaehlter Admin waere ein stilles
# Sicherheitsproblem. Achtung: Ein Tippfehler in ADMIN_NAME legt ein ueberfluessiges Profil
# an, statt abzubrechen; die Startmeldung sagt ausdruecklich, ob ein Profil uebernommen oder
# neu angelegt wurde.
# Nach dem ersten Start sind die drei Werte entbehrlich: Der Bootstrap ist idempotent und
# setzt ein geaendertes Passwort nicht zurueck. ADMIN_PASSWORD danach entfernen.
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Vollstaendige Origin inkl. Schema, ohne Pfad und ohne abschliessenden Schraegstrich.
# Mehrere Werte kommagetrennt. Nur klein schreiben - der Browser sendet den
# Hostnamen im Origin-Header immer in Kleinbuchstaben.
FUBO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMTP-Zugang fuer den Passwort-Reset des Admins (S2b, A22).
# Ohne diese Werte bricht der Start ab - eine Anwendung, die Nachrichten ins Leere
# schickt, faellt sonst erst im Ernstfall auf.
# SMTP_ABSENDER muss zur beim Anbieter freigegebenen Domain gehoeren, sonst lehnt dieser
# den Versand ab. Erlaubt ist die reine Adresse oder die Form
# Anzeigename <adresse@domain>.
#
# ACHTUNG, KEINE ANFUEHRUNGSZEICHEN um die Werte in dieser Datei - und zwar bei keiner
# Variablen. Die .env wird ueber spring.config.import als Java-Properties-Datei gelesen;
# dort sind Anfuehrungszeichen keine Begrenzer, sondern Teil des Werts.
#
# Aus demselben Grund darf kein Skript diese Datei "sourcen": Sie hat keine Shell-Syntax.
# SMTP_ABSENDER in der Form Anzeigename <adresse@domain> laesst die Shell am "<" scheitern,
# und ein Passwort mit "$" wuerde still expandiert. Wer Werte in einem Skript braucht, liest
# die einzelnen Schluessel ohne Interpretation - Vorbild ist scripts/seed-lokal.sh; Docker
# Compose bekommt --env-file .env und parst selbst.
SMTP_HOST=smtp.maileroo.com
SMTP_PORT=587
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_ABSENDER=FuBo-App <noreply@example.org>

# Web Push (S8, A25). Anders als bei SMTP bricht der Start OHNE diese Werte NICHT ab: Die
# Anwendung protokolliert eine Warnung und behandelt Push als abgeschaltet, denn der Kernbetrieb
# laeuft ohne Push vollstaendig. Sichtbar wird das an /api/v1/push/schluessel/lesen, das dann
# mit 503 antwortet.
#
# Die beiden Schluessel sind ein P-256-Paar und werden einmalig je Installation erzeugt.
# Erzeugung und Gegenprobe stehen in harness/tmp/S9_DEPLOYMENT.md, Abschnitt 6.1 - dort auch der
# Hinweis, dass der private Skalar am ANFANG der DER-Struktur steht und nicht am Ende. Ein falsch
# extrahierter privater Wert ist genauso lang wie ein richtiger und faellt deshalb durch keine
# Laengenpruefung; er ist dann in Wahrheit ein Stueck des oeffentlichen Schluessels.
#
# ACHTUNG: Das Paar ist das einzige Geheimnis dieses Projekts, dessen Verlust die NUTZER trifft
# und nicht nur den Betrieb - Abonnements sind an den oeffentlichen Schluessel gebunden, und nach
# einem Wechsel muss jeder Spieler im Browser erneut zustimmen. Es gehoert in dieselbe
# Sicherungsroutine wie die Datenbank und wird nicht routinemaessig rotiert.
# Fuer Entwicklung und Produktion je ein eigenes Paar: Abonnements gelten ohnehin je Origin.
FUBO_VAPID_PUBLIC_KEY=
FUBO_VAPID_PRIVATE_KEY=

# Kontaktadresse des Betreibers nach RFC 8292, als URI mit mailto:-Praefix.
# Kein Geheimnis, aber auch keine Formalie: Ein Push-Dienst benutzt sie, wenn ihm der Absender
# auffaellt - die Adresse muss also Post annehmen. KEIN noreply@, und nicht dieselbe Mailbox wie
# SMTP_ABSENDER; dieselbe Domain ist dagegen sinnvoll. Eine Rollenadresse ist einer persoenlichen
# vorzuziehen, denn der Wert geht bei jedem Versand an Google, Mozilla und Apple.
#
# Das Praefix ist Pflicht: RFC 8292 erklaert den sub-Anspruch fuer optional, Apple lehnt ein JWT
# ohne oder mit unsauber formatiertem sub aber mit BadJwtToken ab. Der Fehler faellt NUR auf einem
# iPhone auf - Google und Mozilla nehmen die Nachricht auch ohne an.
FUBO_VAPID_SUBJECT=mailto:fubo@example.org
